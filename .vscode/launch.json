{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug NestJS (Nest CLI)",
            "args": [
                "start",
                "--debug",
            ],
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run-script"
            ],
            "console": "integratedTerminal",
            "restart": true,
            "sourceMaps": true,
        }
    ]
}