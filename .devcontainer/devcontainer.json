{
  "name": "vault-link",
  "dockerFile": "../Dockerfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "yoavbls.pretty-ts-errors",
        "esbenp.prettier-vscode",
        "mhutchie.git-graph"
      ]
    }
  },
  "workspaceFolder": "/app",
  "mounts": [
    "source=${localWorkspaceFolder},target=/app,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "NODE_ENV": "development"
  }
}
